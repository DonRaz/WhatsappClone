# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3010

# UploadThing configuration
# Replace with your actual token from uploadthing.com
NEXT_PUBLIC_UPLOADTHING_TOKEN=UPLOADTHING_TOKEN=''

# Environment variables for the client
# These are client-side environment variables that will be embedded in the build

# UploadThing API URL for development (pointing to local server)
NEXT_PUBLIC_UPLOADTHING_API_URL=http://localhost:3010/api/uploadthing

# Active storage provider
NEXT_PUBLIC_STORAGE_PROVIDER=uploadthing

 